# Cloudflare Pages / Static CDN Cache-Control Headers

# Immutable assets with content hashes in filename (1 year cache)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/vp-icons.css
  Cache-Control: public, max-age=31536000, immutable

*.woff2
  Cache-Control: public, max-age=31536000, immutable

*.woff
  Cache-Control: public, max-age=31536000, immutable

# Static media and branding assets (1 week cache with stale-while-revalidate)
*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

*.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# HTML documents must revalidate so new deploys are instantly live
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Machine manifests
/posts.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=600

/llms.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=600

/llms-full.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=600
