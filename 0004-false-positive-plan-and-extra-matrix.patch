diff --git a/tests/framework_matrix_extra/python/py08_unrelated_execute.py b/tests/framework_matrix_extra/python/py08_unrelated_execute.py
new file mode 100644
index 0000000..3b6a574
--- /dev/null
+++ b/tests/framework_matrix_extra/python/py08_unrelated_execute.py
@@ -0,0 +1,9 @@
+from flask import Flask, request, redirect, url_for, render_template, render_template_string
+app = Flask(__name__)
+class Cache:
+    def execute(self, key):
+        return key
+cache = Cache()
+@app.route("/u")
